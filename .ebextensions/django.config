option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: "mysite.settings"
  aws:elasticbeanstalk:container:python:
    WSGIPath: mysite.wsgi:application

container_commands:
  01_migrate:
    command: "/var/app/venv/*/bin/python manage.py migrate --noinput"
  02_load_polls:
    command: "/var/app/venv/*/bin/python manage.py loaddata initial_polls"
  03_collectstatic:
    command: "/var/app/venv/*/bin/python manage.py collectstatic --noinput"
  04_database_permissions:
    command: "chown webapp:webapp . db.sqlite3"